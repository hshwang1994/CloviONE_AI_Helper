# /etc/clovirassist/clovirassist.env (spec §28). 0640 root:clovirassist.
# SESSION_SECRET is generated on the server by the installer (openssl rand) —
# never commit a real secret here.
#
# ── 설치처마다 반드시 채워야 하는 값 ─────────────────────────────────────────
# 아래 CHANGE-ME 자리와 빈 값들은 설치처 고유값이다. 예전에는 여기에 최초 고객사의
# 호스트명과 이메일 도메인이 박혀 있었고, 다른 곳에 설치해도 아무도 그 사실을 몰랐다.
# 안 채운 값은 관리 콘솔 > 진단의 '설치처 설정'이 "설정 안 함"으로 표시한다.
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8080
# 사용자가 브라우저로 접속하는 주소. 알림 링크와 리다이렉트가 이 값을 쓴다.
APP_BASE_URL=https://CHANGE-ME.example.internal
# System of Record 는 PostgreSQL 이다(D-187). 유닉스 소켓 + peer 인증이라 비밀번호가
# 없다 — 그 편이 안전하다(env 파일에 평문 비밀번호를 두지 않는다).
DATABASE_URL=postgresql://clovirassist@/clovirassist?host=/var/run/postgresql
# `pg_dump`/`pg_restore`/`psql` 이 있는 디렉터리. **비워 두면 안 된다** — Ubuntu 는
# 버전별 디렉터리에 두고, `PATH` 의 `pg_dump` 는 더 낮은 버전일 수 있다. 서버보다 낮은
# `pg_dump` 는 실행을 거부하므로, 비워 두면 백업이 한 번도 성공한 적 없다는 사실이
# 되돌리려는 날에야 드러난다(app/backups/pg_backup.py).
PG_BIN_DIR=/usr/lib/postgresql/16/bin
# 이 경로는 **n8n 워크플로가 정한 이름**이라 제품 slug 를 따르지 않는다. 바꾸면
# n8n 쪽 웹훅 등록도 함께 바꿔야 하고, 어차피 S11 이 n8n 을 통째로 걷어낸다.
N8N_WORK_ASSISTANT_URL=http://127.0.0.1:5678/webhook/clovirone-work-assistant
SESSION_SECRET=__GENERATED_ON_SERVER__
SESSION_TTL_SECONDS=28800
SESSION_IDLE_TIMEOUT_SECONDS=1800
MAX_MESSAGE_LENGTH=5000
N8N_TIMEOUT_SECONDS=180
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
TRUSTED_PROXY=127.0.0.1
COOKIE_SECURE=true
TIMEZONE=Asia/Seoul
# 계정을 새로 만들 때 허용할 이메일 도메인(쉼표 구분). **비우면 도메인 제한 없음**이다.
# 로그인 검사가 아니라 계정 생성 검사이므로, 비워도 기존 사용자는 그대로 로그인한다.
ALLOWED_EMAIL_DOMAINS=
CONFIG_DIR=/etc/clovirassist
SECRETS_DIR=/etc/clovirassist/secrets
DATA_DIR=/var/lib/clovirassist
# 만료 감시용 인증서 경로. 설치 스크립트가 만드는 파일 이름은 DNS_NAME 을 따른다.
TLS_CERT_PATH=/etc/clovirassist/tls/CHANGE-ME.example.internal.crt
# 노션 데이터베이스 id. 비우면 티켓·리포트·문서 화면이 '연동 필요'로 뜬다(빈 목록이 아니라).
NOTION_TASKS_DATABASE_ID=
NOTION_DOCUMENTS_DATABASE_ID=
# 미러 동기화 주기(초). 이 값은 이제 **관리자 콘솔 › 설정 › 시스템 정책**에서 바꿀 수
# 있고, 거기서 정한 값이 이 env 보다 우선한다(콘솔 값이 0이면 여기 값을 쓴다).
# 워커가 매 틱마다 다시 읽으므로 재시작이 필요 없다.
NOTION_TICKETS_SYNC_INTERVAL_SECONDS=180
# 소스 스위치: notion_cache(기본, 로컬 미러 우선) | notion(킬 스위치, 실시간만) | native(미구현)
TICKET_SOURCE=notion_cache
DOCUMENT_SOURCE=notion

# ── 스케줄러 레인 (S4 · D-225) ──────────────────────────────────────────────
# 스케줄 평가는 `clovirassist-scheduler.service` 라는 **별도 프로세스**가 한다. 배치
# 워커의 tick 이던 시절에는 3600초짜리 잡 하나가 그 시간만큼 스케줄 발화를 통째로 밀었다.
# 이 값을 false 로 두면 스케줄러 프로세스가 리스를 잡기 전에 정상 종료하고, 배치 워커가
# 예전처럼 스케줄러 tick 을 다시 등록한다 — 둘 다 도는 상태는 만들어지지 않는다.
# 기본값이 true 이므로 이 줄은 되돌릴 때만 쓴다.
#WORKER_SCHEDULER_LANE_ENABLED=true

# ── AI Platform (S9 · D-200~D-203) ───────────────────────────────────────────
# 기본이 **꺼짐**이다. AI 기능을 기본 ON 으로 두는 관례가 이 저장소에 없다.
# 설치할 때 `--with-ai` 또는 `--ai-model-dir <디렉터리>` 를 주면 installer 가 이 값을
# true 로 바꾸고 임베딩 런타임과 모델을 함께 깐다. 나중에 켜려면:
#     sudo deploy/install.sh ai --ai-model-dir <모델이 있는 디렉터리>
AI_ENABLED=false
# 임베딩 모델 파일이 사는 뿌리. 비우면 DATA_DIR/ai/models 다. 저장소(storage_providers)와
# **별개**다 — 모델은 사용자 데이터가 아니라 재생성 가능한 자산이고 백업 대상이 아니다.
#AI_MODEL_ROOT=/var/lib/clovirassist/ai/models
# 임베딩 모델. 비우면 제품이 정한 것(D-211)을 쓴다. 제품이 아는 이름만 받는다 —
# 모르는 이름을 주면 켜지지 않는다(조용히 기본값으로 떨어지지 않는다).
#AI_EMBED_MODEL=
# 한 번에 모델에 태우는 chunk 수. S1 실측에서 32가 가장 빨랐다(D-211).
#AI_EMBED_BATCH_SIZE=32
# ONNX Runtime intra-op 스레드. 0이면 런타임 기본값(코어 수)이다.
#AI_EMBED_THREADS=0

# ── 색인 레인 (S9 · D-203) ──────────────────────────────────────────────────
# 파싱·chunk·임베딩은 `clovirassist-index.service` 라는 **별도 프로세스**가 한다.
# 배치 워커 안에 있으면 첨부 하나를 임베딩하는 수 초 동안 메일·동기화·보존이 통째로
# 밀린다. 이 값을 false 로 두면 그 프로세스가 리스를 잡기 전에 정상 종료하고 **색인이
# 멈춘다** — 스케줄러와 달리 배치 워커가 대신 하지 않는다(되돌리면 굶기던 상태로
# 돌아가는데 그것이 이 레인을 만든 이유다). 기본값이 true 이므로 이 줄은 되돌릴 때만 쓴다.
#WORKER_INDEX_LANE_ENABLED=true
# 색인 한 판에서 처리하는 문서 수. 크게 잡으면 한 판이 길어져 종료 신호에 늦게 답한다.
#INDEX_BATCH_DOCUMENTS=20
