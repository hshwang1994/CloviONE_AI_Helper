[Unit]
# 특권 헬퍼 (§S). 웹 유닛은 NoNewPrivileges=true / ProtectSystem=strict 로 하드닝돼 있어
# sudo 도 /etc 쓰기도 할 수 없다 — 그것이 의도다. 관리자 콘솔의 시스템 설정(타임존·DNS·
# 호스트 이름·프록시·인증서·서비스 제어)은 이 프로세스가 대신 수행한다.
#
# 왜 웹에 권한을 주지 않았나: 웹에 sudo 를 주려면 하드닝을 풀어야 하고, 그러면 웹을 뚫은
# 사람이 곧바로 root 가 된다. 하드닝은 그대로 두고 **할 수 있는 일의 목록**을 좁힌 별도
# 프로세스를 두는 편이 훨씬 좁은 문이다. 목록은 app/sysops/actions.py 에 있다.
Description=ClovirAssist privileged helper (system settings)
After=network-online.target
Wants=network-online.target
# 웹보다 먼저 떠 있어야 관리 화면이 "도우미 없음" 을 보여 주지 않는다.
Before=clovirassist-web.service

[Service]
Type=simple
# root 로 돈다. 이것이 이 유닛의 존재 이유이자 위험이므로, 실행 파일이 하는 일을
# app/sysops/ 의 표로 좁혀 두었다. 임의 명령 실행 경로는 코드에 없다.
User=root
# 그룹은 **서비스 계정**이다. 그래야 systemd 가 만드는 RuntimeDirectory 가
# root:clovirassist 가 되고, 0750 에서도 웹이 소켓까지 들어올 수 있다. root uid 라
# 파일 쓰기 권한에는 영향이 없다.
Group=clovirassist
WorkingDirectory=/opt/clovirassist
ExecStart=/opt/clovirassist/venv/bin/python -m app.sysops.helper
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

Environment=CLOVIRASSIST_PRIVHELPER_SOCKET=/run/clovirassist/privhelper.sock
Environment=CLOVIRASSIST_PRIVHELPER_BACKUPS=/var/backups/clovirassist/sysops
Environment=CLOVIRASSIST_PRIVHELPER_AUDIT=/var/log/clovirassist/privhelper.jsonl
Environment=CLOVIRASSIST_SERVICE_USER=clovirassist
# SYS-01: 웹·워커 유닛과 같은 파일을 읽어 TLS_CERT_PATH 를 같은 값으로 얻는다 - 인증서
# 교체 액션(app/sysops/actions_service.py)이 이 값을 안 읽으면 nginx 가 실제로 서빙하는
# 경로가 아니라 아무도 안 읽는 옛 하드코딩 경로에 쓴다("성공"을 보고하는 조용한 무동작).
# `-` 접두사: 이 헬퍼는 설정 파일이 없거나 깨져도 떠 있어야 한다(그래야 그 상황도 관리
# 콘솔의 시스템 화면에서 진단·복구할 수 있다).
EnvironmentFile=-/etc/clovirassist/clovirassist.env

# 소켓 디렉터리를 systemd 가 만들고 재부팅 때 정리한다. 직접 만들면 /run 이 tmpfs 라
# 재부팅 후 사라져 헬퍼가 뜨지 못한다.
RuntimeDirectory=clovirassist
RuntimeDirectoryMode=0750
LogsDirectory=clovirassist
# 🔴 `StateDirectory=` 를 쓰면 안 된다. systemd 는 그 디렉터리를 **이 유닛의 User:Group 으로
# chown 하고 모드를 0755 로 맞춘다.** 이 헬퍼는 root:clovirassist 라
# `/var/lib/clovirassist` 가 root:clovirassist 0755 가 되고, 그러면 그룹에 쓰기가 없어
# **워커가 worker.lock 을 못 만들어 기동에 실패한다.**
# 실제 배포에서 그렇게 터졌다(PermissionError, restart 루프).
# 그 디렉터리는 앱(clovirassist)의 것이고 설치 스크립트가 소유권을 정한다. 헬퍼는 거기에
# 아무것도 저장하지 않는다 - 백업은 /var/backups, 감사는 /var/log 로 간다.

# root 로 돌지만 필요 없는 것은 여전히 막는다. ProtectSystem=strict 는 쓸 수 없다 —
# 이 프로세스의 일 자체가 /etc 쓰기다. 대신 쓸 수 있는 곳을 명시적으로 나열한다.
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0027
# 액션 표가 실제로 건드리는 경로의 목록이다.
# ⚠️ 이 유닛에는 `ProtectSystem=` 이 없으므로 이 줄은 **쓰기를 막지 않는다** - root 는 목록 밖도
# 쓸 수 있다. 경계는 액션 표(app/sysops/actions.py)와 그 안의 이름 검사다. 이 줄은 액션이
# 어디를 쓰는지 한 곳에서 읽히게 하려는 기록이고, 새 액션이 새 경로를 쓰면 함께 적는다.
# `/etc/clovirassist/secrets`: 비밀 값 저장(secret.write, 계획 2.3).
# `/etc/postfix` · `/etc/opendkim`: ClovirAssist 로컬 릴레이 설정과 DKIM 키(mailrelay.*, D-551). `/etc/opendkim.conf` 는 `/etc` 에
# 바로 있는 **파일**이라 여기 적지 않는다(아래 🔴).
# 🔴 **파일 하나를 여기 적으면 안 된다.** systemd 는 `ReadWritePaths=` 의 항목마다 bind mount 를 만든다 — 디렉터리면 그 안의
# `rename()` 이 그대로 되지만, 파일이면 그 파일이 자기 위에 마운트된 마운트 지점이 되어 **새 파일을 그 위로 rename 할 수 없다**
# (`EBUSY`). 랩에서 `/etc/opendkim.conf` 를 적어 둔 채 DKIM 을 켜자 `os.replace('/etc/opendkim.conf.new', '/etc/opendkim.conf')`
# 가 「Device or resource busy」 로 죽어 로컬 릴레이 적용이 통째로 실패했다(2026-10-12). `/etc/hosts` 는 헬퍼가 통째로 바꿔 쓰지
# 않고 제자리에서 고치므로 그대로다(`tests/unit/test_privhelper_unit_paths.py` 가 예외 목록을 들고 있다).
ReadWritePaths=/etc/hosts /etc/systemd /etc/ssl/clovirassist /etc/clovirassist/tls /etc/clovirassist/secrets /var/log/clovirassist /var/backups/clovirassist /run/clovirassist -/etc/postfix -/etc/opendkim

[Install]
WantedBy=multi-user.target
