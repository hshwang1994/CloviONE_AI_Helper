[Unit]
# 특권 헬퍼 (§S). 웹 유닛은 NoNewPrivileges=true / ProtectSystem=strict 로 하드닝돼 있어
# sudo 도 /etc 쓰기도 할 수 없다 — 그것이 의도다. 관리자 콘솔의 시스템 설정(타임존·DNS·
# 호스트 이름·프록시·인증서·서비스 제어)은 이 프로세스가 대신 수행한다.
#
# 왜 웹에 권한을 주지 않았나: 웹에 sudo 를 주려면 하드닝을 풀어야 하고, 그러면 웹을 뚫은
# 사람이 곧바로 root 가 된다. 하드닝은 그대로 두고 **할 수 있는 일의 목록**을 좁힌 별도
# 프로세스를 두는 편이 훨씬 좁은 문이다. 목록은 app/sysops/actions.py 에 있다.
Description=ClovirONE Web Assistant privileged helper (system settings)
After=network-online.target
Wants=network-online.target
# 웹보다 먼저 떠 있어야 관리 화면이 "도우미 없음" 을 보여 주지 않는다.
Before=clovirone-web-assistant.service

[Service]
Type=simple
# root 로 돈다. 이것이 이 유닛의 존재 이유이자 위험이므로, 실행 파일이 하는 일을
# app/sysops/ 의 표로 좁혀 두었다. 임의 명령 실행 경로는 코드에 없다.
User=root
# 그룹은 **웹 계정**이다. 그래야 systemd 가 만드는 RuntimeDirectory 가 root:clovirone-web 이
# 되고, 0750 에서도 웹이 소켓까지 들어올 수 있다. root uid 라 파일 쓰기 권한에는 영향이 없다.
Group=clovirone-web
WorkingDirectory=/opt/clovirone-web-assistant
ExecStart=/opt/clovirone-web-assistant/venv/bin/python -m app.sysops.helper
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

Environment=CLOVIRONE_PRIVHELPER_SOCKET=/run/clovirone-web-assistant/privhelper.sock
Environment=CLOVIRONE_PRIVHELPER_BACKUPS=/var/backups/clovirone-web-assistant/sysops
Environment=CLOVIRONE_PRIVHELPER_AUDIT=/var/log/clovirone-web-assistant/privhelper.jsonl
Environment=CLOVIRONE_SERVICE_USER=clovirone-web
# SYS-01: 웹·워커 유닛과 같은 파일을 읽어 TLS_CERT_PATH 를 같은 값으로 얻는다 - 인증서
# 교체 액션(app/sysops/actions_service.py)이 이 값을 안 읽으면 nginx 가 실제로 서빙하는
# 경로가 아니라 아무도 안 읽는 옛 하드코딩 경로에 쓴다("성공"을 보고하는 조용한 무동작).
# `-` 접두사: 이 헬퍼는 web.env 가 없거나 깨져도 떠 있어야 한다(그래야 그 상황도 관리
# 콘솔의 시스템 화면에서 진단·복구할 수 있다).
EnvironmentFile=-/etc/clovirone-web-assistant/web.env

# 소켓 디렉터리를 systemd 가 만들고 재부팅 때 정리한다. 직접 만들면 /run 이 tmpfs 라
# 재부팅 후 사라져 헬퍼가 뜨지 못한다.
RuntimeDirectory=clovirone-web-assistant
RuntimeDirectoryMode=0750
LogsDirectory=clovirone-web-assistant
# 🔴 `StateDirectory=` 를 쓰면 안 된다. systemd 는 그 디렉터리를 **이 유닛의 User:Group 으로
# chown 하고 모드를 0755 로 맞춘다.** 이 헬퍼는 root:clovirone-web 이라
# `/var/lib/clovirone-web-assistant` 가 root:clovirone-web 0755 가 되고, 그러면 그룹에
# 쓰기가 없어 **워커가 worker.lock 을 못 만들어 기동에 실패한다.**
# 실제 배포에서 그렇게 터졌다(PermissionError, restart 루프).
# 그 디렉터리는 앱(clovirone-web)의 것이고 설치 스크립트가 소유권을 정한다. 헬퍼는 거기에
# 아무것도 저장하지 않는다 - 백업은 /var/backups, 감사는 /var/log 로 간다.

# root 로 돌지만 필요 없는 것은 여전히 막는다. ProtectSystem=strict 는 쓸 수 없다 —
# 이 프로세스의 일 자체가 /etc 쓰기다. 대신 쓸 수 있는 곳을 명시적으로 나열한다.
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0027
# 액션 표가 실제로 건드리는 경로만. 새 액션이 다른 곳을 쓰려 하면 여기서 막히고,
# 그때 이 목록을 늘릴지 사람이 판단하게 된다(조용히 늘어나지 않는다).
ReadWritePaths=/etc/hosts /etc/systemd /etc/ssl/clovirone /etc/clovirone-web-assistant/tls /var/log/clovirone-web-assistant /var/backups/clovirone-web-assistant /run/clovirone-web-assistant

[Install]
WantedBy=multi-user.target
