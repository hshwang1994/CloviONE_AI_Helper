[Unit]
Description=ClovirAssist Conversational Worker (chat + LLM connection test)
# **PostgreSQL 이 먼저 떠야 한다** (D-187). 근거는 웹 유닛과 같다.
After=network-online.target postgresql.service clovirassist-web.service
Wants=network-online.target postgresql.service
# 배치 워커 유닛과 같은 이유(OPS-10).
# 🔴 재시도 예산이 **리스 수명보다 길어야 한다** (S22). 워커 리스는 120초를 산다
# (app/core/worker_lock.py::DEFAULT_LEASE_SECONDS). 앞선 프로세스가 리스를 남기고
# 사라진 상태 - 되돌리기 · 갑작스러운 정전 · 강제 종료 - 에서 새 워커는 리스가 만료될
# 때까지 «다른 워커가 이미 돌고 있다» 며 물러난다. RestartSec=10 · Burst=10 이면
# 재시도가 100초 남짓에 끝나 **리스가 풀리기 전에 systemd 가 먼저 포기했다** - 그러면
# 레인은 사람이 손대기 전까지 영영 안 돌아온다. Burst 를 20 으로 두어 재시도 창
# (약 200초)이 리스를 넘게 한다. 300초 안에 20회이므로 여전히 유한한 고리다.
StartLimitIntervalSec=300
StartLimitBurst=20

# D-118: 이 유닛은 **설치·활성화돼 있어도 안전하다.** `worker_conversational_lane_enabled`
# 가 꺼져 있으면(기본값) `main()` 이 리스를 잡기 전에 exit(0) 하고 `inactive (dead)` 로
# 쉰다 — 그것이 이 유닛의 정상 대기 상태다. 그래서 재부팅 복구 판정에서 «떠 있어야 하는
# 유닛»(app/core/product.py::ALWAYS_ACTIVE_UNITS)에는 들어가지 않는다.
# 배포 상태와 설정이 갈라지지 않게 유닛은 항상 설치한다(PA-05 부류의 drift 회피).

[Service]
Type=simple
User=clovirassist
Group=clovirassist
WorkingDirectory=/opt/clovirassist
EnvironmentFile=/etc/clovirassist/clovirassist.env
ExecStartPre=-/opt/clovirassist/deploy/wait-for-postgres.sh
ExecStart=/opt/clovirassist/venv/bin/python -m app.worker_main --lane=conversational
Restart=on-failure
RestartSec=10
# 배치 워커와 달리 이 레인의 잡(chat_message/llm_connection_test)은 전부 모델 응답 상한
# (기본 180초) 안에서 끝나거나 실패한다 — schedule_run류의 3600초짜리 예외가 없으므로
# 200초면 정상 종료를 충분히 덮는다(배치 유닛의 같은 값이 세운 근거를 그대로 따른다).
KillSignal=SIGTERM
TimeoutStopSec=200

# Hardening (배치 워커 유닛과 동일, spec §26.1)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
UMask=0027
# `-/run/clovirassist`: 워커도 특권 헬퍼의 소켓에 닿아야 한다. AI 계정 연결의 토큰 갱신이
# 워커에서 돌고, 갱신된 토큰은 헬퍼가 비밀 파일로 쓴다(계획 2.3). 웹 유닛과 같은 줄이고,
# 앞의 `-` 때문에 헬퍼를 안 깐 설치에서도 유닛은 그대로 뜬다.
ReadWritePaths=/var/lib/clovirassist -/run/clovirassist

[Install]
WantedBy=multi-user.target
