[Unit]
Description=ClovirONE Web Assistant API/UI
# **PostgreSQL 이 먼저 떠야 한다** (D-187). SQLite 시절에는 DB 가 파일이라 기다릴
# 서비스가 없었다 — 그래서 이 줄이 없었다. 지금 없으면 재부팅 때 이 유닛이 PG 보다
# 먼저 떠서 접속에 실패하고, `Restart=on-failure` 로 몇 번 죽었다 되살아난다.
# 결과적으로는 복구되지만 그건 운이지 설계가 아니다.
#
# `Requires=` 가 아니라 `Wants=` 인 이유: PG 를 잠시 재시작해도 이 유닛까지 함께
# 멈추지는 않게 한다. 접속이 끊긴 동안은 앱이 재시도로 버틴다.
#
# ⚠️ `After=` 만으로는 **접속 가능**을 보장하지 못한다(유닛이 active 인 것과 소켓이
# 받는 것은 다르다). 기동 시 PG 준비 대기는 INSTALLATION.md §6 이 S4 에 요구한다.
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=clovirone-web
Group=clovirone-web
WorkingDirectory=/opt/clovirone-web-assistant
EnvironmentFile=/etc/clovirone-web-assistant/web.env
# --workers 는 이제 올릴 수 있다 (D-192). **그 조건이 무엇이었는지 적어 둔다.**
#
# 예전에는 1 이 고정이었다. 로그인 무차별 대입 제한·채팅 전송 제한·AI 퀴즈 제한·티켓 배정
# 잠금·쿼터 잠금이 전부 **프로세스 안 메모리**에 있었기 때문이다. 워커를 N개로 올리면
# 그 상태도 N벌이 되고 요청이 프로세스에 흩어지므로, '분당 10회' 제한이 실질 'N×10회'가
# 된다 — 워커를 늘리는 순간 방어가 조용히 N배 약해지고 로그에는 아무 흔적이 없다.
#
# 그 다섯을 공유 저장소로 옮긴 뒤에야 이 값을 올렸다. **순서 규약: 저장소를 먼저, 워커는
# 그 다음.**
#   * rate limit  -> `rate_limit_buckets` 표 (app/core/ratelimit.py)
#   * 티켓 배정 / 쿼터 / 재색인 / 동기화 / Notion 생성 잠금
#                 -> PostgreSQL advisory lock (app/core/advisory_lock.py)
#   * 설정 캐시   -> 요청 길목에서 TTL 갱신 (app/settings/service.py)
#
# 4 는 이 서버(8 vCPU)에 맞춘 값이다. 올릴 때 함께 봐야 하는 것은 PostgreSQL 의
# `max_connections` 다: 워커 수 x (pool_size + max_overflow) 가 그 안에 들어와야 한다.
# 기본값 5+10 이므로 4 워커면 60 이고, PG 기본 100 안이다
# (app/core/db.py::DEFAULT_POOL_SIZE 주석에 계산이 적혀 있다).
ExecStart=/opt/clovirone-web-assistant/venv/bin/uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8080 --workers 4
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

# Hardening (spec §26.1)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
UMask=0027
# 앞의 `-` 는 "없으면 그냥 넘어가라" 다. 특권 헬퍼(§S)를 안 깐 설치에서도 웹은 떠야 한다 —
# `-` 없이 적으면 경로가 없을 때 유닛이 시작에 실패해 서비스가 통째로 안 뜬다.
# 하드닝은 **그대로 둔다.** 시스템 설정은 헬퍼가 대신 하므로 여기서 풀 이유가 없다.
ReadWritePaths=/var/lib/clovirone-web-assistant -/run/clovirone-web-assistant

[Install]
WantedBy=multi-user.target
