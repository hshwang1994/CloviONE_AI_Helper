[Unit]
Description=ClovirONE Web Assistant Background Worker (jobs + scheduler)
# **PostgreSQL 이 먼저 떠야 한다** (D-187). SQLite 시절에는 DB 가 파일이라 기다릴
# 서비스가 없었다 — 그래서 이 줄이 없었다. 지금 없으면 재부팅 때 이 유닛이 PG 보다
# 먼저 떠서 접속에 실패하고, `Restart=on-failure` 로 몇 번 죽었다 되살아난다.
# 결과적으로는 복구되지만 그건 운이지 설계가 아니다.
#
# `Requires=` 가 아니라 `Wants=` 인 이유: PG 를 잠시 재시작해도 이 유닛까지 함께
# 멈추지는 않게 한다. 접속이 끊긴 동안은 앱이 재시도로 버틴다.
#
# ⚠️ `After=` 만으로는 **접속 가능**을 보장하지 못한다(유닛이 active 인 것과 소켓이
# 받는 것은 다르다). 기동 시 PG 준비 대기는 INSTALLATION.md §6 이 S4 에 요구한다.
After=network-online.target postgresql.service clovirone-web-assistant.service
Wants=network-online.target postgresql.service
# OPS-10: 예전엔 이 둘이 없어 systemd 기본값(대략 10초 안에 5회)을 썼다. worker_lock.py 의
# WorkerLockError(권한 어긋남·디스크 가득 참 같은 파일시스템 고장, 리스 경쟁이 아니다)가
# 안 잡히던 시절엔 그 조합이 몇 초 안에 재시작 한도를 태워 유닛이 조용히 failed 로 멈췄다
# (잡·스케줄러·하트비트가 전부 죽었는데 능동적으로 지켜보지 않으면 아무도 모른다). 지금은
# WorkerLockError 를 잡아 깨끗이 종료하지만(app/worker_main.py), 그래도 순간적인 문제가
# 스스로 풀릴 시간을 더 주고 - 그래도 안 풀리면 여전히 결국은 멈춘다(무한 재시도는 아니다).
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=clovirone-web
Group=clovirone-web
WorkingDirectory=/opt/clovirone-web-assistant
EnvironmentFile=/etc/clovirone-web-assistant/web.env
ExecStart=/opt/clovirone-web-assistant/venv/bin/python -m app.worker_main
Restart=on-failure
RestartSec=10
# Graceful shutdown: stop claiming new jobs and finish the in-flight one, then
# exit (spec §26.2). 200s covers the common jobs (chat answer cap 180s). A rare
# long schedule job (timeout up to 3600s) is SIGKILLed at this deadline and then
# recovered by the stuck-job sweeper on restart (recover_stuck, 3900s cutoff) —
# a deliberate trade-off to keep restarts/upgrades from stalling up to an hour.
KillSignal=SIGTERM
TimeoutStopSec=200

# Hardening (spec §26.1)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
UMask=0027
ReadWritePaths=/var/lib/clovirone-web-assistant

[Install]
WantedBy=multi-user.target
