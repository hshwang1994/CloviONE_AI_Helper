# n8n 실행 데이터 보존 설정 — /etc/n8n/n8n.env 에 append 후 systemctl restart n8n
#
# 배경(2026-07-17 감사): 실행 207건에 DB 1,021MB. 채팅 워크플로가 실행마다 조회 캐시
# (staticData ~3.3MB)를 노드 출력으로 execution_data에 통째 저장해 실행당 ~5MB씩 쌓인다.
# n8n 기본 프루닝(336h/10000건)은 이 크기 증가를 못 막고, SQLite는 VACUUM 없이는 줄지 않는다.
#
# EXECUTIONS_DATA_MAX_AGE: 실행 기록 보존 시간(시간 단위). 168 = 7일.
# EXECUTIONS_DATA_PRUNE_MAX_COUNT: 보존 최대 건수. 300건 × ~5MB ≈ 1.5GB 상한.
# DB_SQLITE_VACUUM_ON_STARTUP: 기동 시 VACUUM으로 파일 크기 회수(기동 지연 수십 초, 재시작 드묾).
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=300
DB_SQLITE_VACUUM_ON_STARTUP=true
