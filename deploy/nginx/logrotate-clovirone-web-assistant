# ClovirONE Web Assistant nginx 로그 회전 (P6).
#
# ⚠️ 이 파일은 **조건부로만** 설치된다.
# 데비안/우분투의 nginx 패키지는 /etc/logrotate.d/nginx 에서 `/var/log/nginx/*.log` 를
# 이미 회전시킨다. 우리 로그도 그 glob 에 들어가므로 거기서 이미 처리된다. 그 상태에서
# 이 파일까지 넣으면 logrotate 가 "duplicate log entry" 를 내고 **그날의 회전 전체가
# 실패한다** - nginx 로그뿐 아니라 그 실행에 묶인 다른 로그까지 같이 안 돈다.
# 그래서 scripts/install-clovirone-web-assistant.sh 가 먼저 확인하고, 배포판 설정이
# 우리 파일을 이미 덮고 있으면 이것을 설치하지 않는다(그리고 예전 설치가 넣어 뒀다면 지운다).
#
# 값은 데비안 nginx 기본값과 같게 맞췄다. 다르게 두면 같은 디렉터리의 로그가 서로 다른
# 주기로 돌아 조사할 때 시간대가 어긋난다.

/var/log/nginx/clovirone-web-assistant.access.log
/var/log/nginx/clovirone-web-assistant.error.log {
	daily
	missingok
	rotate 14
	compress
	delaycompress
	notifempty
	create 0640 www-data adm
	sharedscripts
	prerotate
		if [ -d /etc/logrotate.d/httpd-prerotate ]; then \
			run-parts /etc/logrotate.d/httpd-prerotate; \
		fi \
	endscript
	postrotate
		# 열려 있던 파일 핸들을 놓고 새 파일에 쓰게 한다. 이게 없으면 nginx 가
		# 이름이 바뀐 옛 파일에 계속 써서 디스크만 차고 새 로그는 비어 있다.
		if [ -f /var/run/nginx.pid ]; then \
			kill -USR1 `cat /var/run/nginx.pid`; \
		fi
	endscript
}
