# Development example. Production uses /etc/clovirone-web-assistant/web.env (spec §28).
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
APP_BASE_URL=http://127.0.0.1:8080
DATABASE_URL=sqlite:///./var/web.sqlite3
N8N_WORK_ASSISTANT_URL=http://127.0.0.1:5678/webhook/clovirone-work-assistant
SESSION_SECRET=dev-only-change-me
SESSION_TTL_SECONDS=28800
SESSION_IDLE_TIMEOUT_SECONDS=1800
MAX_MESSAGE_LENGTH=5000
N8N_TIMEOUT_SECONDS=180
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
TRUSTED_PROXY=127.0.0.1
COOKIE_SECURE=false
TIMEZONE=Asia/Seoul
# 계정 생성 시 허용할 이메일 도메인(쉼표 구분). 비우면 도메인 제한 없음.
# 로그인 검사가 아니라 계정 생성 검사다 - 비워도 기존 사용자는 그대로 로그인한다.
ALLOWED_EMAIL_DOMAINS=
# 노션 데이터베이스 id. 설치처마다 다르므로 기본값이 없다. 비우면 티켓/리포트/문서 화면이
# 빈 목록이 아니라 '연동 필요'로 뜨고, 관리 콘솔 진단이 "설정 안 함"이라고 말한다.
NOTION_TASKS_DATABASE_ID=
NOTION_DOCUMENTS_DATABASE_ID=
# 미러 동기화 주기(초). 이 값은 이제 **관리자 콘솔 › 설정 › 시스템 정책**에서 바꿀 수
# 있고, 거기서 정한 값이 이 env 보다 우선한다(콘솔 값이 0이면 여기 값을 쓴다).
# 워커가 매 틱마다 다시 읽으므로 재시작이 필요 없다.
NOTION_TICKETS_SYNC_INTERVAL_SECONDS=180
# 프로젝트 미러 동기화 주기. 티켓보다 느슨한 이유는 app/core/config.py 에 적어 뒀다.
# 프로젝트 DB id 는 설정에 없다 - 작업 DB 의 프로젝트 연결 속성을 따라간다.
NOTION_PROJECTS_SYNC_INTERVAL_SECONDS=600
# 소스 스위치: notion_cache(기본, 로컬 미러 우선) | notion(킬 스위치, 실시간만) | native(미구현)
TICKET_SOURCE=notion_cache
DOCUMENT_SOURCE=notion
